; SOLARIT: RANDSEKTOR 07 — standalone, dependency-free Godot RTS
config_version=5

[application]
config/name="SOLARIT RANDSEKTOR 07"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
rendering/rendering_device/driver.windows="vulkan"
# Supersampled 3D cache art uses multisampling, with full-resolution SSAO for
# contact detail in the battlefield models.
rendering/anti_aliasing/quality/msaa_3d=2
rendering/environment/ssao/quality=3
rendering/environment/ssao/half_size=false
rendering/environment/ssao/blur_passes=3
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.035,0.049,0.06,1)

[audio]
driver/enable_input=false
