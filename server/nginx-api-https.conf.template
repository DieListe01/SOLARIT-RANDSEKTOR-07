# HTTPS service after the separate enable-https.sh reachability confirmation.
server {
    listen 80;
    listen [::]:80;
    server_name api.dl-home.de;

    client_max_body_size 64k;
    access_log off;
    error_log /var/log/nginx/solarit-api-error.log crit;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 308 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name api.dl-home.de;

    ssl_certificate /etc/letsencrypt/live/api.dl-home.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.dl-home.de/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;
    access_log off;
    error_log /var/log/nginx/solarit-api-error.log crit;

    location / {
        limit_except GET POST { deny all; }
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_read_timeout 10s;
        proxy_send_timeout 10s;
    }
}
